# Variáveis do docker-compose.yml (copie para `.env` na raiz do repositório).
# O backend em dev tem o próprio arquivo: openem_backend/.env.example.

# Senha do PostgreSQL — obrigatória. Use só letras e números (ela entra crua na
# DATABASE_URL do backend). Ex.: openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_USER=openem
# POSTGRES_DB=openem
# Porta publicada só em 127.0.0.1, para o backend de dev fora do Docker.
# POSTGRES_PORT=5432

# Senha do Redis (Valkey), o cache da API — obrigatória. Só letras e números
# (ela entra crua na REDIS_URL do backend). Ex.: openssl rand -hex 24
REDIS_PASSWORD=
# Porta publicada só em 127.0.0.1, para o backend de dev fora do Docker.
# REDIS_PORT=6379
# Memória máxima do cache; cheio, ele descarta as chaves menos usadas.
# REDIS_MAXMEMORY=128mb

# Na primeira subida o backend popula o banco vazio (seed + import das provas).
# AUTO_IMPORT=0 desliga.
# AUTO_IMPORT=1

# Segredo do JWT — obrigatório. Ex.: openssl rand -hex 32
JWT_SECRET=
# JWT_EXPIRES_IN=7d

# Domínio público da instalação (opcional), ex.: https://openem.exemplo. Entra
# no build do site (sitemap.xml e as URLs absolutas do Open Graph) e o backend
# monta com ele o link do e-mail de redefinição de senha e a volta do login com
# Google. Sem ele, o site sai sem sitemap e com URLs relativas, e esses dois
# recursos ficam desligados.
# SITE_URL=https://openem.exemplo

# Código-fonte que o app mostra no Login e no Perfil (opcional). A AGPL-3.0
# pede que quem usa o app pela rede possa obter o código que roda nele: se você
# modificou o OpENEM, aponte para o seu fork. Vazio: o repositório oficial.
# SOURCE_URL=https://github.com/migueldsants/OpENEM

# Recuperação de senha por e-mail (opcional; precisa da SITE_URL). Com as duas,
# o "Esqueci minha senha" manda um link que vale 30 minutos; sem elas, a tela
# de entrada esconde o link. smtps:// é TLS direto (porta 465); smtp:// usa
# STARTTLS quando o servidor oferece (porta 587). Usuário e senha com caracteres
# especiais vão codificados (@ vira %40). Ver /docs/hospedar/email-e-google/.
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
# MAIL_FROM="OpENEM <nao-responda@openem.exemplo>"

# Login com Google (opcional; precisa da SITE_URL). Cliente OAuth do tipo
# "Aplicativo da Web" no Google Cloud, com o URI de redirecionamento
# <SITE_URL>/api/v1/auth/google/callback.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=troque-pelo-segredo-do-cliente

# Cota das chamadas pagas à IA, em 24 h (opcional). Vazio usa o padrão:
# 30 comentários de questão por aluno, sem teto global. AI_DAILY_LIMIT soma
# todos os alunos: defina em produção.
# AI_EXPLANATION_DAILY_LIMIT=30
# AI_DAILY_LIMIT=500
