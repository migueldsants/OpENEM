# Variáveis do docker-compose.yml (copie para `.env` na raiz do repositório).
# O backend em dev tem o próprio arquivo: openem_backend/.env.example.

# Senha do PostgreSQL — obrigatória. Use só letras e números (ela entra crua na
# DATABASE_URL do backend). Ex.: openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_USER=openem
# POSTGRES_DB=openem
# Porta publicada só em 127.0.0.1, para o backend de dev fora do Docker.
# POSTGRES_PORT=5432

# Senha do Redis (Valkey), o cache da API — obrigatória. Só letras e números
# (ela entra crua na REDIS_URL do backend). Ex.: openssl rand -hex 24
REDIS_PASSWORD=
# Porta publicada só em 127.0.0.1, para o backend de dev fora do Docker.
# REDIS_PORT=6379
# Memória máxima do cache; cheio, ele descarta as chaves menos usadas.
# REDIS_MAXMEMORY=128mb

# Na primeira subida o backend popula o banco vazio (seed + import das provas).
# AUTO_IMPORT=0 desliga.
# AUTO_IMPORT=1

# Segredo do JWT — obrigatório. Ex.: openssl rand -hex 32
JWT_SECRET=
# JWT_EXPIRES_IN=7d

# Cota das chamadas pagas à IA, em 24 h (opcional). Vazio usa o padrão:
# 30 comentários de questão por aluno, sem teto global. AI_DAILY_LIMIT soma
# todos os alunos: defina em produção.
# AI_EXPLANATION_DAILY_LIMIT=30
# AI_DAILY_LIMIT=500
