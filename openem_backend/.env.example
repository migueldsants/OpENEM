# Banco de dados — PostgreSQL (ver docs/PRD.md §9 e §12).
# Em dev, suba só o banco do compose na raiz do repositório
# (`docker compose up -d db`, com POSTGRES_PASSWORD no .env da raiz) e use a
# mesma senha aqui. A suíte e2e usa este mesmo banco, no schema `test_e2e`,
# que ela apaga e recria a cada execução — o `public` não é tocado.
DATABASE_URL="postgresql://openem:troque-esta-senha@localhost:5432/openem?schema=public"

# Porta da API
PORT=3000

# Cache compartilhado (issue #86) — opcional. Com REDIS_URL, as leituras de
# catálogo (matérias, provas, facetas, questão) e as estrelas do GitHub ficam
# no Redis, valendo para todas as instâncias da API e invalidadas pelos scripts
# de seed/import/classificação. Sem ela, o cache fica na memória do processo
# (bom para dev e para uma instância só; as chaves de catálogo duram 1 minuto,
# porque o script roda em outro processo e não alcança essa memória).
# Se o Redis cair, a API lê do banco e o /health mostra `redis: down`.
# Em dev, com o compose da raiz: `docker compose up -d redis` e
# REDIS_URL="redis://:<REDIS_PASSWORD>@localhost:6379"
# REDIS_URL="redis://:troque-esta-senha@localhost:6379"

# CORS — origens permitidas separadas por vírgula (ex.: https://app.openem.org).
# Opcional: em dev o Vite já usa proxy de mesma origem.
# CORS_ORIGINS="https://app.openem.org"

# Rate limiting (issue #49) — limite padrão por IP, contado em cada rota
# separadamente. Rotas caras (login, PDF, IA, fórum) têm limites próprios.
# Valor inválido cai no padrão.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# Fila dos PDFs (cadernos de simulado e de fórmulas). Cada PDF é desenhado numa
# worker thread, para não travar a API: no máximo PDF_CONCURRENCY ao mesmo
# tempo, PDF_MAX_QUEUE esperando (além disso, 503 na hora) e PDF_TIMEOUT_MS
# por desenho.
# PDF_CONCURRENCY=1
# PDF_MAX_QUEUE=8
# PDF_TIMEOUT_MS=60000

# Proxy reverso — quantos proxies ficam à frente da API (o docker-compose usa 1:
# o nginx do frontend). Sem isso, atrás de proxy, todo aluno aparece com o IP
# do proxy e o rate limiting vira um contador único para o site inteiro.
# Não ligue sem proxy na frente: o cliente forjaria o X-Forwarded-For.
# Aceita também uma lista de sub-redes (ex.: "loopback, 10.0.0.0/8"); "true"
# é recusado.
# TRUST_PROXY=1

# Autenticação JWT — obrigatório fora do ambiente local de desenvolvimento.
# Sem JWT_SECRET (ou com um segredo <= 16 chars em produção) a API falha na inicialização.
# Gere um segredo forte (ex.: openssl rand -hex 32).
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# IA — comentário de questões e classificação de assunto. Provedores opcionais
# e intercambiáveis. Sem nenhum configurado, esses recursos ficam indisponíveis
# e o app segue funcionando sem eles.
#
# Provedor ativo (opcional): anthropic | openai | gemini | openai-compatible.
# Se omitido, usa o primeiro provedor configurado (nesta ordem de prioridade).
# Variável vazia conta como não definida.
# AI_PROVIDER="anthropic"
#
# Modelos por recurso (opcionais; o padrão é o modelo do provedor abaixo).
# A classificação por IA pega só o que ficou sem assunto depois das palavras-
# chave e do catálogo (provas importadas depois); prefira um modelo barato.
# AI_EXPLANATION_MODEL="claude-sonnet-5"
# AI_CLASSIFY_MODEL="claude-haiku-4-5-20251001"
#
# Anthropic (Claude)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"
#
# OpenAI (GPT)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
#
# OpenAI-compatível (Ollama, Groq, OpenRouter, LM Studio, vLLM…)
# Defina a base URL; a chave é opcional para servidores locais. Use AI_PROVIDER=openai-compatible.
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="llama3.1"
#
# Google Gemini (aceita GEMINI_API_KEY ou GOOGLE_API_KEY)
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.5-flash"
#
# Cota das chamadas pagas à IA, numa janela de 24 h. 0 desliga o teto.
# Por aluno: comentários gerados de questão (comentário já gravado não conta).
# AI_DAILY_LIMIT soma todos os alunos.
# AI_EXPLANATION_DAILY_LIMIT=30
# AI_DAILY_LIMIT=500

# Questões oficiais do ENEM (npm run db:import:enem).
# Onde o dataset baixado fica (padrão: prisma/.enem-dataset, ignorado pelo git)
# ENEM_DATASET_DIR="./prisma/.enem-dataset"
# Onde as imagens das questões ficam; o backend as serve em /media/enem/.
# Padrão: public/enem. No Docker, /data/enem-media (volume enem-media, separado
# do banco).
# ENEM_MEDIA_DIR="./public/enem"
