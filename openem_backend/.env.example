# Banco de dados — SQLite na fase atual (ver docs/PRD.md §9).
# O caminho é relativo ao diretório prisma/ quando usado pela CLI do Prisma.
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3000

# CORS — origens permitidas separadas por vírgula (ex.: https://app.openem.org).
# Opcional: em dev o Vite já usa proxy de mesma origem.
# CORS_ORIGINS="https://app.openem.org"

# Rate limiting (issue #49) — limite global padrão por IP.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# Proxy reverso — quantos proxies ficam à frente da API (o docker-compose usa 1:
# o nginx do frontend). Sem isso, atrás de proxy, todo aluno aparece com o IP
# do proxy e o rate limiting vira um contador único para o site inteiro.
# Não ligue sem proxy na frente: o cliente forjaria o X-Forwarded-For.
# Aceita também uma lista de sub-redes (ex.: "loopback, 10.0.0.0/8"); "true"
# é recusado.
# TRUST_PROXY=1

# Autenticação JWT — obrigatório fora do ambiente local de desenvolvimento.
# Sem JWT_SECRET (ou com um segredo <= 16 chars em produção) a API falha na inicialização.
# Gere um segredo forte (ex.: openssl rand -hex 32).
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# IA (Fase 3) — correção de redação, comentário de questões e classificação de
# assunto. Provedores opcionais e intercambiáveis. Sem nenhum configurado, esses
# recursos ficam indisponíveis e o app segue funcionando sem eles.
#
# Provedor ativo (opcional): anthropic | openai | openai-compatible | gemini.
# Se omitido, usa o primeiro provedor configurado (nesta ordem de prioridade).
# AI_PROVIDER vale para todos os recursos; ESSAY_AI_PROVIDER, se definido,
# sobrescreve só a correção de redação.
# AI_PROVIDER="anthropic"
# ESSAY_AI_PROVIDER="anthropic"
#
# Modelos por recurso (opcionais; o padrão é o modelo do provedor abaixo).
# A classificação percorre ~4 mil questões: prefira um modelo barato.
# AI_EXPLANATION_MODEL="claude-sonnet-5"
# AI_CLASSIFY_MODEL="claude-haiku-4-5-20251001"
#
# Anthropic (Claude)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"
#
# OpenAI (GPT)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
#
# OpenAI-compatível (Ollama, Groq, OpenRouter, LM Studio, vLLM…)
# Defina a base URL; a chave é opcional para servidores locais. Use ESSAY_AI_PROVIDER=openai-compatible.
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="llama3.1"
#
# Google Gemini (aceita GEMINI_API_KEY ou GOOGLE_API_KEY)
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.5-flash"

# Questões oficiais do ENEM (npm run db:import:enem).
# Onde o dataset baixado fica (padrão: prisma/.enem-dataset, ignorado pelo git)
# ENEM_DATASET_DIR="./prisma/.enem-dataset"
# Onde as imagens das questões ficam; o backend as serve em /media/enem/.
# Padrão: public/enem. No Docker, /data/enem-media (mesmo volume do banco).
# ENEM_MEDIA_DIR="./public/enem"
