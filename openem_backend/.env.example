# Banco de dados — SQLite na fase atual (ver docs/PRD.md §9).
# O caminho é relativo ao diretório prisma/ quando usado pela CLI do Prisma.
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3000

# Autenticação JWT — gere um segredo forte em produção (ex.: openssl rand -hex 32)
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# IA (Fase 3) — correção de redação por IA. Provedores opcionais e intercambiáveis.
# Sem nenhum configurado, a correção por IA fica indisponível e o app usa a rubrica manual.
#
# Provedor ativo (opcional): anthropic | openai | openai-compatible | gemini.
# Se omitido, usa o primeiro provedor configurado (nesta ordem de prioridade).
# ESSAY_AI_PROVIDER="anthropic"
#
# Anthropic (Claude)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"
#
# OpenAI (GPT)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
#
# OpenAI-compatível (Ollama, Groq, OpenRouter, LM Studio, vLLM…)
# Defina a base URL; a chave é opcional para servidores locais. Use ESSAY_AI_PROVIDER=openai-compatible.
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="llama3.1"
#
# Google Gemini (aceita GEMINI_API_KEY ou GOOGLE_API_KEY)
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.5-flash"
