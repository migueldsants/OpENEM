// OpENEM — esquema Prisma (Fase 0 / MVP)
// Datasource SQLite na fase atual; produção -> PostgreSQL (ver docs/PRD.md §9).
// SQLite não tem enum nativo no Prisma: usamos String com valores controlados na aplicação.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  profile      Profile?
  answers      Answer[]
  simulations  Simulation[]
  reviewItems  ReviewItem[]
  favorites    Favorite[]
  studyPlan    StudyPlan?
  essays       EssaySubmission[]
  gamification GamificationStat?
  achievements UserAchievement[]
  dailyChallenges DailyChallengeLog[]
  xpLogs       XpLog[]
  gameScores   GameScore[]
  forumThreads ForumThread[]
  forumPosts   ForumPost[]
  postLikes    ForumPostLike[]
  questionNotes QuestionNote[]
  flashcardDecks FlashcardDeck[]
  flashcardReviews FlashcardReview[]
  weeklyGoals WeeklyGoal[]
  formulaFavorites UserFormula[]
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          String  @default("SISU") // SISU | PROUNI | TREINEIRO
  minutesPerDay Int     @default(60)
  displayName   String?
  focusMode     Boolean @default(false) // modo sem distrações (Fase 2)
  gamificationEnabled Boolean @default(true) // toggle de gamificação (Fase 3)
  onboarded     Boolean @default(false) // false até o 1º onboarding ser concluído
}

// Área do conhecimento ENEM (nível mais alto da taxonomia canônica).
model SubjectArea {
  id       String    @id @default(cuid())
  name     String    @unique
  subjects Subject[]
  weeklyGoals WeeklyGoal[]
}

model Subject {
  id            String      @id @default(cuid())
  name          String      @unique
  subjectAreaId String
  subjectArea   SubjectArea @relation(fields: [subjectAreaId], references: [id], onDelete: Cascade)
  topics        Topic[]
  weeklyGoals   WeeklyGoal[]
  formulas      Formula[]

  @@index([subjectAreaId])
}

model Topic {
  id            String         @id @default(cuid())
  name          String
  subjectId     String
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weight        Int            @default(3) // peso Pareto 1..5 (incidência no ENEM)
  questions     Question[]
  reviewItems   ReviewItem[]
  studySessions StudySession[]
  weeklyGoals   WeeklyGoal[]
  formulas      Formula[]

  @@unique([subjectId, name])
}

model ExamYear {
  id        String     @id @default(cuid())
  year      Int        @unique
  questions Question[]
}

model Question {
  id           String        @id @default(cuid())
  statement    String
  difficulty   Int           @default(3) // 1..5 (questões por nível)
  explanation  String
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  examYearId   String?
  examYear     ExamYear?     @relation(fields: [examYearId], references: [id])
  alternatives Alternative[]
  answers      Answer[]
  favorites    Favorite[]
  forumThreads ForumThread[]
  notes        QuestionNote[]

  // Parâmetros TRI (modelo logístico de 3 parâmetros) — nullable até haver calibração (Fase 2)
  discrimination Float? // a — discriminação
  irtDifficulty  Float? // b — dificuldade na escala latente
  guessing       Float? // c — acerto ao acaso (0..1)

  @@index([topicId, difficulty])
}

model Alternative {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
}

// Anotações pessoais do usuário em questões (issue #39). Markdown livre.
model QuestionNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
}

model SimulationTemplate {
  id            String       @id @default(cuid())
  name          String
  scope         String       @default("FULL") // AREA | FULL
  subjectId     String?
  questionCount Int          @default(10)
  timeLimitMin  Int?
  simulations   Simulation[]
}

model Simulation {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   SimulationTemplate @relation(fields: [templateId], references: [id])
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  rawScore   Float?
  triScore   Float? // [PLACEHOLDER Fase 2]
  answers    Answer[]
}

model Answer {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenId     String?
  isCorrect    Boolean     @default(false)
  timeSpentSec Int?
  simulationId String?
  simulation   Simulation? @relation(fields: [simulationId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([userId, questionId])
}

model ReviewItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  easeFactor Float    @default(2.5) // SM-2 simplificado
  intervalD  Int      @default(0)
  repetition Int      @default(0)
  dueAt      DateTime @default(now())

  @@unique([userId, topicId])
}

// ---- Fase 2 ----

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model StudyPlan {
  id            String         @id @default(cuid())
  userId        String         @unique // um plano ativo por usuário
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutesPerDay Int
  createdAt     DateTime       @default(now())
  sessions      StudySession[]
}

model StudySession {
  id       String    @id @default(cuid())
  planId   String
  plan     StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  topicId  String
  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  dayIndex Int // 0..n
  minutes  Int
  done     Boolean   @default(false)

  @@index([planId, dayIndex])
}

// ---- Metas semanais (issue #44) ----

// Meta de estudo da semana: "estudar X min de Biologia" ou "resolver Y
// questões de Matemática". weekStart é a segunda-feira (00:00 UTC) da semana;
// `completed` é recalculado a cada leitura a partir do progresso real.
model WeeklyGoal {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Escopo opcional da meta (null = meta geral da semana).
  subjectAreaId  String?
  subjectArea    SubjectArea? @relation(fields: [subjectAreaId], references: [id], onDelete: SetNull)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId        String?
  topic          Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  targetMinutes  Int      @default(0) // meta de tempo (0 = sem meta de tempo)
  targetQuestions Int     @default(0) // meta de questões (0 = sem meta de questões)
  weekStart      DateTime // segunda-feira 00:00 UTC da semana da meta
  createdAt      DateTime @default(now())

  @@index([userId, weekStart])
}

// ---- Fórmulas / cheat sheet (issue #38) ----

// Fórmula essencial catalogada (a maioria é builtIn, via seed). `latex`
// guarda a expressão em LaTeX para renderizar no MathLive/KaTeX.
model Formula {
  id          String        @id @default(cuid())
  title       String        @unique
  latex       String
  description String?
  subjectId   String
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  isBuiltIn   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  favoritedBy UserFormula[]

  @@index([subjectId])
  @@index([title])
}

// Favorito de fórmula (many-to-many usuário ↔ fórmula).
model UserFormula {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formulaId String
  formula   Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, formulaId])
}

model EssayPrompt {
  id           String            @id @default(cuid())
  title        String
  theme        String // tema da redação
  instructions String
  year         Int?
  createdAt    DateTime          @default(now())
  submissions  EssaySubmission[]
}

model EssaySubmission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId    String
  prompt      EssayPrompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  content     String
  submittedAt DateTime         @default(now())
  evaluation  EssayEvaluation?
}

model EssayEvaluation {
  id           String          @id @default(cuid())
  submissionId String          @unique
  submission   EssaySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  c1           Int // competência 1 (0..200)
  c2           Int
  c3           Int
  c4           Int
  c5           Int
  total        Int // 0..1000
  feedback     String? // comentário geral da redação
  // JSON (IA): resumo por competência { c1..c5: string }
  competencyFeedback String?
  // JSON (IA): anotações por erro [{ competency, start, end, excerpt, comment, suggestion }]
  annotations  String?
  evaluatedAt  DateTime        @default(now())
}

// ---- Fase 3 (gamificação) ----

// Estatísticas de gamificação do usuário (1:1). O catálogo de conquistas vive
// no código (common/gamification.ts); aqui guardamos apenas o estado acumulado.
model GamificationStat {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  points         Int       @default(0)
  currentStreak  Int       @default(0) // dias consecutivos com atividade
  longestStreak  Int       @default(0)
  lastActivityOn DateTime? // dia (00:00) da última atividade contabilizada
  answersCount   Int       @default(0)
  correctCount   Int       @default(0)
  // Contadores por atividade (Fase 3, issue #17) — alimentam conquistas específicas.
  simulationsCount Int     @default(0)
  essaysCount      Int     @default(0)
  highScoreEssays  Int     @default(0) // redações com nota >= 800
  reviewsCount     Int     @default(0)
  sessionsDone     Int     @default(0)
  updatedAt      DateTime  @updatedAt
}

// Conquistas desbloqueadas (uma linha por conquista por usuário).
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String // referencia ACHIEVEMENTS em common/gamification.ts
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
}

// Histórico de XP ganho por ação (issue #17) — alimenta o gráfico de XP por dia
// e o feed de atividades na tela Progresso.
model XpLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // ANSWER | SIMULATION | ESSAY | REVIEW | STUDY_SESSION | DAILY_CHALLENGE
  xpGained  Int
  // Detalhe legível (ex.: "10 acertos em simulado", "Redação nota 820") — opcional.
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---- Fase 3 (avançado) ----

// Registro de conclusão do desafio diário (uma linha por usuário por dia).
// O conteúdo do desafio é determinístico (common/daily-challenge.ts); aqui só
// guardamos a data e se a recompensa de XP já foi resgatada.
model DailyChallengeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // dia no formato YYYY-MM-DD (UTC)
  claimedAt DateTime @default(now())

  @@unique([userId, day])
}

// Comunidade/fórum: tópicos e respostas (Fase 3).
model ForumThread {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  questionId String? // tópico opcionalmente ligado a uma questão
  question   Question?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  posts      ForumPost[]

  @@index([createdAt])
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())
  likes     ForumPostLike[]

  @@index([threadId, createdAt])
}

// Curtidas em respostas do fórum (issue #19). Um like por usuário por post
// (índice único). A exclusão é em cascata com o post.
model ForumPostLike {
  id        String   @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// ---- Fase 3 (avançado) — Flashcards (issue #36) ----

// Conjunto de flashcards (público ou privado do usuário).
model FlashcardDeck {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String
  isPublic      Boolean    @default(false)
  // subject = nome do Subject; topic = matéria; subtheme = subtema dentro da matéria
  subject       String
  topic         String?
  subtheme      String?
  weight        Int        @default(3) // peso Pareto 1..5 (5 = alta incidência ENEM)
  icon          String      @default("📚")
  upvotes       Int         @default(0)
  downvotes     Int         @default(0)
  createdAt     DateTime    @default(now())
  flashcards    Flashcard[]

  @@index([isPublic, upvotes]) // ordenação por popularidade
  @@index([subject])
}

model Flashcard {
  id        String          @id @default(cuid())
  deckId    String
  deck      FlashcardDeck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front     String          // Markdown (pergunta)
  back      String          // Markdown (resposta)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  reviews   FlashcardReview[]

  @@index([deckId, order])
}

// Estado SM-2 de revisão por flashcard por usuário (reutiliza common/spaced-repetition).
model FlashcardReview {
  id           String   @id @default(cuid())
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  easeFactor   Float    @default(2.5)
  intervalD    Int      @default(0)
  repetition   Int      @default(0)
  dueAt        DateTime @default(now())
  lastQuality  Int?     // última nota 0..5
  reviewedAt   DateTime @default(now())

  @@unique([userId, flashcardId])
  @@index([userId, dueAt]) // fila "vencidos primeiro"
}

// ---- Fase 3 (avançado) — Games (issue #18) ----

// Pontuação de um usuário em um minigame (uma linha por partida).
model GameScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameKey    String   // chave do GameDefinition (catálogo em código)
  score      Int
  level      Int      // nível alcançado no minigame
  durationSec Int
  createdAt  DateTime @default(now())

  @@index([gameKey, score]) // leaderboard por jogo
}
