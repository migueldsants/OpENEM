// OpENEM — esquema Prisma (Fase 0 / MVP)
// Datasource PostgreSQL em dev, testes e produção (ver docs/PRD.md §9 e §12).
// Os "enums" são String com valores controlados na aplicação, herança da fase
// SQLite; trocar por enum nativo do Postgres fica para depois.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  /// Nulo na conta criada pelo Google, que entra sem senha.
  passwordHash        String?
  /// Vai no JWT (`ver`) e é conferido a cada pedido: incrementar encerra
  /// todas as sessões (troca e redefinição de senha, sair de todos os
  /// dispositivos).
  tokenVersion        Int                  @default(0)
  /// `sub` da conta Google vinculada (OIDC). Não muda se o e-mail mudar lá.
  googleSub           String?              @unique
  /// Quando o dono provou que o e-mail é dele (Google ou link de
  /// redefinição). Nulo na conta criada só com senha: o cadastro não confirma
  /// o e-mail.
  emailVerifiedAt     DateTime?
  createdAt           DateTime             @default(now())
  /// Quando o aluno aceitou os Termos de Uso e a Política de Privacidade, e
  /// qual versão (common/terms.ts). Nulos nas contas criadas antes do aceite.
  termsAcceptedAt     DateTime?
  termsVersion        String?
  profile             Profile?
  answers             Answer[]
  simulations         Simulation[]
  reviewItems         ReviewItem[]
  favorites           Favorite[]
  studyPlan           StudyPlan?
  essays              EssaySubmission[]
  gamification        GamificationStat?
  achievements        UserAchievement[]
  dailyChallenges     DailyChallengeLog[]
  xpLogs              XpLog[]
  forumThreads        ForumThread[]
  forumPosts          ForumPost[]
  postLikes           ForumPostLike[]
  forumReports        ForumReport[]
  questionNotes       QuestionNote[]
  flashcardDecks      FlashcardDeck[]
  flashcardReviews    FlashcardReview[]
  deckVotes           FlashcardDeckVote[]
  weeklyGoals         WeeklyGoal[]
  formulas            Formula[]
  formulaFavorites    UserFormula[]
  focusSessions       FocusSession[]
  videos              Video[]
  videoNotes          VideoNote[]
  simulationTemplates SimulationTemplate[]
  themes              UserTheme[]
  themeLikes          UserThemeLike[]
  aiUsages            AiUsage[]
  passwordResetTokens PasswordResetToken[]
  loginCodes          LoginCode[]
}

model Profile {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                String  @default("SISU") // SISU | PROUNI | TREINEIRO
  minutesPerDay       Int     @default(60)
  displayName         String?
  /// Nome público (fórum, ranking, perfil público, temas), único e em
  /// minúsculas, conferido por `common/nickname.ts`. Obrigatório no cadastro;
  /// nulo só em conta antiga ou nova pelo Google, e o app pede antes de abrir.
  nickname            String? @unique
  focusMode           Boolean @default(false) // modo sem distrações (Fase 2)
  gamificationEnabled Boolean @default(true) // toggle de gamificação (Fase 3)
  onboarded           Boolean @default(false) // false até o 1º onboarding ser concluído
  /// Língua estrangeira escolhida na prova. O ENEM tem inglês e espanhol, e o
  /// banco guarda as duas versões de cada questão — sem isso o aluno vê tudo em dobro.
  foreignLanguage     String  @default("ingles") // ingles | espanhol
}

// Área do conhecimento ENEM (nível mais alto da taxonomia canônica).
model SubjectArea {
  id          String               @id @default(cuid())
  name        String               @unique
  subjects    Subject[]
  weeklyGoals WeeklyGoal[]
  questions   Question[]
  templates   SimulationTemplate[]
}

model Subject {
  id            String         @id @default(cuid())
  name          String         @unique
  subjectAreaId String
  subjectArea   SubjectArea    @relation(fields: [subjectAreaId], references: [id], onDelete: Cascade)
  topics        Topic[]
  weeklyGoals   WeeklyGoal[]
  formulas      Formula[]
  focusSessions FocusSession[]
  videos        Video[]
  studySessions StudySession[]

  @@index([subjectAreaId])
}

model Topic {
  id          String       @id @default(cuid())
  name        String
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weight      Int          @default(3) // peso Pareto 1..5 (incidência no ENEM)
  questions   Question[]
  reviewItems ReviewItem[]
  weeklyGoals WeeklyGoal[]
  formulas    Formula[]

  @@unique([subjectId, name])
}

// Uma aplicação de prova. `year` não é único: a reaplicação de 2023 também é
// year 2023, e só o slug as distingue.
model ExamYear {
  id              String               @id @default(cuid())
  /// "2023", "2023-reaplicacao" — espelha o diretório do dataset de origem.
  slug            String               @unique
  year            Int
  /// Rótulo de exibição: "ENEM 2023", "ENEM 2023 (reaplicação)".
  label           String
  isReapplication Boolean              @default(false)
  /// Aplicação: REGULAR | REAPLICACAO | SEGUNDA_APLICACAO | TERCEIRA_APLICACAO
  /// | DIGITAL | REGIONAL — ver `ExamKind` em common/enem-import/mapping.ts.
  kind            String               @default("REGULAR")
  questions       Question[]
  templates       SimulationTemplate[]

  @@index([year])
}

model Question {
  id                String               @id @default(cuid())
  /// Chave estável da origem externa: "enem:<slug-da-prova>:<pasta-da-questão>".
  /// Nula em questões autorais/seed — o índice único aceita vários NULLs.
  externalId        String?              @unique
  /// Código legível da questão oficial: "ENEM-2023-136", "ENEM-2023R-136",
  /// "ENEM-2023-001-ING". Buscável pelo aluno.
  code              String?              @unique
  /// Número no caderno oficial (1..180): ordena o simulado da prova e define
  /// o dia (1–90 no primeiro, 91–180 no segundo).
  number            Int?
  source            String               @default("AUTORAL") // AUTORAL | ENEM_DEV
  /// Texto de apoio da questão, em Markdown (pode conter imagens e LaTeX).
  statement         String
  /// O comando da questão ("Qual é a massa..."), quando vem separado do apoio.
  questionPrompt    String?
  /// Idioma da questão de língua estrangeira: null | "ingles" | "espanhol".
  language          String?
  difficulty        Int                  @default(3) // 1..5 (questões por nível)
  /// Nulo enquanto não houver comentário — as questões oficiais chegam sem ele.
  explanation       String?
  /// Origem do comentário: "seed" | "humano" | "ai:<provedor>". Alimenta o aviso da UI.
  explanationSource String?
  /// Área do conhecimento. É o que a questão tem antes de ser classificada em
  /// matéria/tópico — por isso o topicId abaixo é opcional.
  subjectAreaId     String?
  subjectArea       SubjectArea?         @relation(fields: [subjectAreaId], references: [id], onDelete: SetNull)
  topicId           String?
  /// SetNull (e não Cascade): o seed remove áreas fora da TAXONOMY, e em cascata
  /// isso apagaria todo o banco de questões importadas.
  topic             Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  examYearId        String?
  examYear          ExamYear?            @relation(fields: [examYearId], references: [id])
  alternatives      Alternative[]
  answers           Answer[]
  favorites         Favorite[]
  forumThreads      ForumThread[]
  notes             QuestionNote[]
  simulations       SimulationQuestion[]

  // Parâmetros TRI (modelo logístico de 3 parâmetros) — nullable até haver calibração (Fase 2)
  discrimination Float? // a — discriminação
  irtDifficulty  Float? // b — dificuldade na escala latente
  guessing       Float? // c — acerto ao acaso (0..1)

  // Confiança da classificação automática de tópico e nº de tentativas já feitas
  // (sem o contador, o job reprocessa para sempre as questões que a IA recusa).
  classificationConfidence Float?
  classificationAttempts   Int     @default(0)
  /// Quem classificou o assunto: "dataset" | "keywords" |
  /// "catalogo:claude-haiku" | "ai:<provedor>".
  /// Distingue o que a heurística decidiu do que a IA confirmou.
  classificationSource     String?

  @@index([topicId, difficulty])
  @@index([subjectAreaId, difficulty])
  @@index([subjectAreaId, topicId])
  @@index([examYearId, number])
  @@index([language])
}

model Alternative {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Letra oficial do gabarito ("A".."E"). Nula em questões autorais antigas,
  /// onde a letra é derivada da posição.
  letter     String?
  text       String
  /// Alternativa que é uma imagem (gráficos, mapas). Caminho relativo servido
  /// pelo próprio backend, nunca a URL de origem.
  imageUrl   String?
  isCorrect  Boolean  @default(false)
  /// Ordem de exibição. Sem ela a ordem vinha do rowid, indefinida por contrato —
  /// e ordem errada com letra semântica é gabarito errado na tela.
  position   Int      @default(0)

  @@index([questionId, position])
}

// Anotações pessoais do usuário em questões (issue #39). Markdown livre.
model QuestionNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
}

model SimulationTemplate {
  id            String       @id @default(cuid())
  name          String
  scope         String       @default("FULL") // AREA | FULL | EXAM | CUSTOM
  subjectId     String?
  /// Área do conhecimento do simulado (scope AREA). É o recorte que alcança as
  /// questões oficiais ainda sem matéria/assunto, onde `subjectId` não chega.
  subjectAreaId String?
  subjectArea   SubjectArea? @relation(fields: [subjectAreaId], references: [id], onDelete: SetNull)
  questionCount Int          @default(10)
  timeLimitMin  Int?
  /// Simulado salvo por um aluno (scope CUSTOM); nulo nos simulados do catálogo.
  ownerId       String?
  owner         User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Filtros do simulado personalizado, em JSON (ver common/simulation-filters).
  /// Guardados como texto, herança da fase SQLite (sem tipo Json no Prisma).
  filters       String?
  createdAt     DateTime     @default(now())
  /// Prova oficial (scope EXAM): a aplicação e o dia do ENEM que o simulado
  /// reproduz, na ordem do caderno. Criados pelo importador das provas.
  examYearId    String?
  examYear      ExamYear?    @relation(fields: [examYearId], references: [id])
  day           Int? // 1 | 2
  /// Fora da lista de simulados, mas preservado: há histórico ligado a ele.
  archived      Boolean      @default(false)
  simulations   Simulation[]

  @@unique([examYearId, day])
}

model Simulation {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   SimulationTemplate   @relation(fields: [templateId], references: [id])
  startedAt  DateTime             @default(now())
  finishedAt DateTime?
  rawScore   Float?
  triScore   Float? // [PLACEHOLDER Fase 2]
  answers    Answer[]
  questions  SimulationQuestion[]
}

// Questões sorteadas para um simulado, na ordem da prova. É o que o finish()
// corrige: sem essa lista o cliente podia entregar questões de fora do simulado
// (o gabarito é público) e inflar nota, XP e ranking. Simulados anteriores a
// esta tabela não têm linhas aqui e seguem corrigidos pelo que foi entregue.
model SimulationQuestion {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position     Int

  @@unique([simulationId, questionId])
}

model Answer {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenId     String?
  isCorrect    Boolean     @default(false)
  timeSpentSec Int?
  simulationId String?
  simulation   Simulation? @relation(fields: [simulationId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([userId, questionId])
}

model ReviewItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  easeFactor Float    @default(2.5) // SM-2 simplificado
  intervalD  Int      @default(0)
  repetition Int      @default(0)
  dueAt      DateTime @default(now())

  @@unique([userId, topicId])
}

// ---- Fase 2 ----

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model StudyPlan {
  id            String         @id @default(cuid())
  userId        String         @unique // um plano ativo por usuário
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutesPerDay Int
  createdAt     DateTime       @default(now())
  sessions      StudySession[]
}

model StudySession {
  id        String    @id @default(cuid())
  planId    String
  plan      StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Nome livre do bloco: "Matemática", "Inglês", "Revisar simulado".
  /// É a fonte de verdade do que aparece no calendário.
  label     String
  /// Matéria do ENEM correspondente, quando o nome bate com o catálogo.
  /// Serve para cor e relatórios; nulo em blocos livres.
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dayIndex  Int // 0..n
  minutes   Int
  done      Boolean   @default(false)
  /// Ordem do bloco dentro do dia.
  position  Int       @default(0)

  @@index([planId, dayIndex])
}

// ---- Metas semanais (issue #44) ----

// Meta de estudo da semana: "estudar X min de Biologia" ou "resolver Y
// questões de Matemática". weekStart é a segunda-feira da semana de Brasília
// (rótulo: 00:00 UTC da data);
// `completed` é recalculado a cada leitura a partir do progresso real.
model WeeklyGoal {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Escopo opcional da meta (null = meta geral da semana).
  subjectAreaId   String?
  subjectArea     SubjectArea? @relation(fields: [subjectAreaId], references: [id], onDelete: SetNull)
  subjectId       String?
  subject         Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId         String?
  topic           Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  targetMinutes   Int          @default(0) // meta de tempo (0 = sem meta de tempo)
  targetQuestions Int          @default(0) // meta de questões (0 = sem meta de questões)
  weekStart       DateTime // segunda-feira 00:00 UTC da semana da meta
  createdAt       DateTime     @default(now())

  @@index([userId, weekStart])
}

// ---- Fórmulas / cheat sheet (issue #38) ----

// Fórmula essencial catalogada (a maioria é builtIn, via seed). `latex`
// guarda a expressão em LaTeX para renderizar no MathLive/KaTeX.
//
// O catálogo (isBuiltIn) aparece para todos; a fórmula personalizada, só para
// quem a criou (ownerId). O título é único por dono, e não no banco inteiro:
// um título global deixava um aluno ocupar o nome de uma fórmula que o seed
// ainda ia criar. No catálogo (ownerId nulo) quem garante o título único é o
// seed, porque o índice único trata cada NULL como distinto.
model Formula {
  id          String          @id @default(cuid())
  title       String
  latex       String
  description String?
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  isBuiltIn   Boolean         @default(true)
  ownerId     String?
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  favoritedBy UserFormula[]
  symbols     FormulaSymbol[]

  @@unique([ownerId, title])
  @@index([subjectId])
  @@index([title])
}

// Legenda de uma fórmula: o que cada símbolo/letra representa e em que
// unidade. Sem isso a cola só serve para quem já sabe ler a expressão.
model FormulaSymbol {
  id        String  @id @default(cuid())
  formulaId String
  formula   Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  /// Símbolo em LaTeX, ex.: "\Delta s".
  symbol    String
  /// Significado em português, ex.: "deslocamento".
  meaning   String
  /// Unidade no SI quando faz sentido, ex.: "m/s". Nulo para adimensionais.
  unit      String?
  /// Ordem de exibição dentro da fórmula.
  position  Int     @default(0)

  @@index([formulaId])
}

// Favorito de fórmula (many-to-many usuário ↔ fórmula).
model UserFormula {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formulaId String
  formula   Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, formulaId])
}

// ---- Modo Foco / Pomodoro (issue #41) ----

// Sessão de foco concluída (Pomodoro 25/5 ou tempo livre). O registro é
// criado apenas quando a sessão termina — timers em andamento vivem no cliente.
model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  durationSec Int
  startedAt   DateTime
  completedAt DateTime @default(now())

  @@index([userId, completedAt])
}

// ---- Videoteca (issue #37) ----

// Vídeo de estudo salvo pelo usuário (link do YouTube). Metadados (título/
// thumbnail) vêm do oEmbed público do YouTube no momento do save.
model Video {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeId String
  title     String
  thumbnail String?
  subjectId String?
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  watched   Boolean     @default(false)
  createdAt DateTime    @default(now())
  notes     VideoNote[]

  @@index([userId, subjectId])
  @@index([youtubeId])
}

// Nota vinculada a um instante do vídeo (timestamp clicável no player).
model VideoNote {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestampSec Int
  content      String
  createdAt    DateTime @default(now())

  @@index([videoId, timestampSec])
}

model EssayPrompt {
  id           String            @id @default(cuid())
  title        String
  theme        String // tema da redação
  instructions String
  year         Int?
  createdAt    DateTime          @default(now())
  submissions  EssaySubmission[]
}

model EssaySubmission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId    String
  prompt      EssayPrompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  content     String
  submittedAt DateTime         @default(now())
  evaluation  EssayEvaluation?
}

model EssayEvaluation {
  id                 String          @id @default(cuid())
  submissionId       String          @unique
  submission         EssaySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  c1                 Int // competência 1 (0..200)
  c2                 Int
  c3                 Int
  c4                 Int
  c5                 Int
  total              Int // 0..1000
  feedback           String? // comentário geral da redação
  // As duas colunas JSON abaixo vinham da correção por IA, que foi removida:
  // ficam para não perder as avaliações antigas, e nada novo as preenche.
  // JSON: resumo por competência { c1..c5: string }
  competencyFeedback String?
  // JSON: anotações por erro [{ competency, start, end, excerpt, comment, suggestion }]
  annotations        String?
  evaluatedAt        DateTime        @default(now())
}

// ---- Fase 3 (gamificação) ----

// Estatísticas de gamificação do usuário (1:1). O catálogo de conquistas vive
// no código (common/gamification.ts); aqui guardamos apenas o estado acumulado.
model GamificationStat {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  points           Int       @default(0)
  currentStreak    Int       @default(0) // dias consecutivos com atividade
  longestStreak    Int       @default(0)
  lastActivityOn   DateTime? // dia de Brasília da última atividade contabilizada (00:00 UTC da data)
  answersCount     Int       @default(0)
  correctCount     Int       @default(0)
  // Contadores por atividade (Fase 3, issue #17) — alimentam conquistas específicas.
  simulationsCount Int       @default(0)
  essaysCount      Int       @default(0)
  highScoreEssays  Int       @default(0) // redações com nota >= 800
  reviewsCount     Int       @default(0)
  sessionsDone     Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

// Conquistas desbloqueadas (uma linha por conquista por usuário).
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String // referencia ACHIEVEMENTS em common/gamification.ts
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
}

// Histórico de XP ganho por ação (issue #17) — alimenta o gráfico de XP por dia
// e o feed de atividades na tela Progresso.
model XpLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // ANSWER | SIMULATION | ESSAY | REVIEW | STUDY_SESSION | DAILY_CHALLENGE
  xpGained  Int
  // Detalhe legível (ex.: "10 acertos em simulado", "Redação nota 820") — opcional.
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---- Fase 3 (avançado) ----

// Registro de conclusão do desafio diário (uma linha por usuário por dia).
// O conteúdo do desafio é determinístico (common/daily-challenge.ts); aqui só
// guardamos a data e se a recompensa de XP já foi resgatada.
model DailyChallengeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // dia de Brasília no formato YYYY-MM-DD
  claimedAt DateTime @default(now())

  @@unique([userId, day])
}

// Comunidade/fórum: tópicos e respostas (Fase 3).
model ForumThread {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  questionId String? // tópico opcionalmente ligado a uma questão
  question   Question?     @relation(fields: [questionId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  posts      ForumPost[]
  reports    ForumReport[]

  @@index([createdAt])
}

model ForumPost {
  id        String          @id @default(cuid())
  threadId  String
  thread    ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime        @default(now())
  likes     ForumPostLike[]
  reports   ForumReport[]

  @@index([threadId, createdAt])
}

// Curtidas em respostas do fórum (issue #19). Um like por usuário por post
// (índice único). A exclusão é em cascata com o post.
model ForumPostLike {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// Denúncia de um tópico ou de uma resposta do fórum. Ainda não há tela de
// moderação: quem hospeda lê esta tabela (ver docs, hospedar/produção). Um
// aluno tem no máximo uma denúncia por alvo (a segunda troca o motivo), e o
// alvo apagado leva a denúncia junto. `postId` nulo = denúncia do tópico.
model ForumReport {
  id         String      @id @default(cuid())
  reporterId String
  reporter   User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  threadId   String
  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  postId     String?
  post       ForumPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([reporterId, threadId, postId])
  @@index([createdAt])
}

// ---- Fase 3 (avançado) — Flashcards (issue #36) ----

// Conjunto de flashcards (público ou privado do usuário).
model FlashcardDeck {
  id          String              @id @default(cuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  isPublic    Boolean             @default(false)
  // subject = nome do Subject; topic = matéria; subtheme = subtema dentro da matéria
  subject     String
  topic       String?
  subtheme    String?
  weight      Int                 @default(3) // peso Pareto 1..5 (5 = alta incidência ENEM)
  icon        String              @default("books")
  upvotes     Int                 @default(0)
  downvotes   Int                 @default(0)
  createdAt   DateTime            @default(now())
  flashcards  Flashcard[]
  votes       FlashcardDeckVote[]

  @@index([isPublic, upvotes]) // ordenação por popularidade
  @@index([subject])
}

// Voto de um aluno num deck público: um por aluno e por deck. Os totais seguem
// em upvotes/downvotes (a ordenação usa eles); esta tabela é o que impede votar
// de novo. Votos anteriores a ela já estão nos totais e não têm linha aqui.
model FlashcardDeckVote {
  id        String        @id @default(cuid())
  deckId    String
  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      String // up | down
  createdAt DateTime      @default(now())

  @@unique([deckId, userId])
}

model Flashcard {
  id        String            @id @default(cuid())
  deckId    String
  deck      FlashcardDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front     String // Markdown (pergunta)
  back      String // Markdown (resposta)
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  reviews   FlashcardReview[]

  @@index([deckId, order])
}

// Estado SM-2 de revisão por flashcard por usuário (reutiliza common/spaced-repetition).
model FlashcardReview {
  id          String    @id @default(cuid())
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  easeFactor  Float     @default(2.5)
  intervalD   Int       @default(0)
  repetition  Int       @default(0)
  dueAt       DateTime  @default(now())
  lastQuality Int? // última nota 0..5
  reviewedAt  DateTime  @default(now())

  @@unique([userId, flashcardId])
  @@index([userId, dueAt]) // fila "vencidos primeiro"
}

/// Tema de cores criado pelo aluno (tela Temas). Guarda os dois lados
/// (claro/escuro) como JSON com os 10 tokens, sempre `#rrggbb`: as cores são
/// aplicadas com style.setProperty no navegador de quem usa o tema, inclusive
/// de outros alunos quando ele é publicado (ver common/theme-tokens.ts).
model UserTheme {
  id          String          @id @default(cuid())
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  light       String
  dark        String
  /// Nasce privado; publicado aparece na aba Comunidade.
  isPublic    Boolean         @default(false)
  /// Total de curtidas. A tabela UserThemeLike só impede a segunda curtida.
  likes       Int             @default(0)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  likeRows    UserThemeLike[]

  @@unique([ownerId, name])
  @@index([isPublic, likes])
  @@index([isPublic, publishedAt])
}

model UserThemeLike {
  id        String    @id @default(cuid())
  themeId   String
  theme     UserTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([themeId, userId])
}

/// Chamada paga à IA feita para um aluno (comentário de questão). Uma linha por
/// tentativa, gravada antes da chamada: é o que conta a cota de 24 h por aluno
/// e o teto global (ver ai-usage/ai-usage.service.ts).
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// explanation. Linhas antigas podem ter `essay`, da correção de redação por
  /// IA que foi removida; elas só contam no teto global até saírem da janela.
  feature   String
  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
  @@index([createdAt])
}

/// Link de "esqueci minha senha". Só o hash SHA-256 do token fica no banco (o
/// token vai no e-mail); vale 30 minutos e uma vez só. Pedir outro link apaga
/// os anteriores do aluno.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Código de uso único do login com Google: o callback grava o hash e manda o
/// código ao app, que o troca pelo token por POST (o JWT nunca vai na URL).
model LoginCode {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash         String   @unique
  /// A senha da conta, nunca confirmada, foi desativada ao vincular o Google:
  /// o app avisa o aluno.
  passwordDisabled Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
