{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing (issue #47). Roda sobre o código de domínio (não muta bootstrap, DTOs e modules); thresholds calibrados para subir gradualmente.",
  "packageManager": "npm",
  "testRunner": "jest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.module.ts",
    "!src/**/dto/**",
    "!src/main.ts",
    "!src/prisma/**",
    "!src/health/**",
    "!src/**/*.controller.ts",
    "!src/auth/jwt-auth.guard.ts",
    "!src/auth/jwt.strategy.ts",
    "!src/auth/current-user.decorator.ts",
    "!src/common/essay-ai/**",
    "!src/essays/essays.service.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 30
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental-backend.json",
  "concurrency": 2,
  "timeoutMS": 30000,
  "jest": {
    "configFile": "stryker.jest.json",
    "config": {
      "rootDir": ".."
    }
  }
}