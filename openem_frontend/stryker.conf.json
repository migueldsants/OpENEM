{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing (issue #47) — vitest runner. Muta apenas lógica testável em unit (libs, hooks, fila offline, componentes puros pequenos); páginas/telas grandes e board (canvas) ficam de fora — mutantes de JSX/render têm custo alto e valor baixo no estágio atual.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/**/*.ts",
    "src/offline/queue.ts",
    "src/components/AchievementToast.tsx",
    "src/components/EmptyState.tsx",
    "src/components/ErrorBanner.tsx",
    "src/components/GamificationFeedback.tsx",
    "src/components/WeeklyGoalsCard.tsx",
    "src/components/PomodoroTimer.tsx",
    "src/components/performance/TopicHeatmap.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental-frontend.json",
  "concurrency": 2,
  "timeoutMS": 30000,
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}