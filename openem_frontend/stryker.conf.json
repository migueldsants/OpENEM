{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing (issue #47) — vitest runner. Incremental para o CI não rodar mutantes já testados.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/main.tsx",
    "!src/vite-env.d.ts",
    "!src/test/**",
    "!src/board/**",
    "!src/lib/areas.ts",
    "!src/lib/gamification.ts",
    "!src/theme-custom.ts",
    "!src/theme.tsx",
    "!src/api.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental-frontend.json",
  "concurrency": 2,
  "timeoutMS": 30000,
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}